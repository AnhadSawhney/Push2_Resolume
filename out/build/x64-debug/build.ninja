build include\glfw\src\glfw3.lib: C_STATIC_LIBRARY_LINKER__glfw_Debug include\glfw\src\CMakeFiles\glfw.dir\context.c.obj include\glfw\src\CMakeFiles\glfw.dir\init.c.obj include\glfw\src\CMakeFiles\glfw.dir\input.c.obj include\glfw\src\CMakeFiles\glfw.dir\monitor.c.obj include\glfw\src\CMakeFiles\glfw.dir\platform.c.obj include\glfw\src\CMakeFiles\glfw.dir\vulkan.c.obj include\glfw\src\CMakeFiles\glfw.dir\window.c.obj include\glfw\src\CMakeFiles\glfw.dir\egl_context.c.obj include\glfw\src\CMakeFiles\glfw.dir\osmesa_context.c.obj include\glfw\src\CMakeFiles\glfw.dir\null_init.c.obj include\glfw\src\CMakeFiles\glfw.dir\null_monitor.c.obj include\glfw\src\CMakeFiles\glfw.dir\null_window.c.obj include\glfw\src\CMakeFiles\glfw.dir\null_joystick.c.obj include\glfw\src\CMakeFiles\glfw.dir\win32_module.c.obj include\glfw\src\CMakeFiles\glfw.dir\win32_time.c.obj include\glfw\src\CMakeFiles\glfw.dir\win32_thread.c.obj include\glfw\src\CMakeFiles\glfw.dir\win32_init.c.obj include\glfw\src\CMakeFiles\glfw.dir\win32_joystick.c.obj include\glfw\src\CMakeFiles\glfw.dir\win32_monitor.c.obj include\glfw\src\CMakeFiles\glfw.dir\win32_window.c.obj include\glfw\src\CMakeFiles\glfw.dir\wgl_context.c.obj
  LANGUAGE_COMPILE_FLAGS = /DWIN32 /D_WINDOWS /W3 /MDd /Ob0 /Od /RTC1 -ZI
  LINK_FLAGS = /machine:x64
  OBJECT_DIR = include\glfw\src\CMakeFiles\glfw.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = include\glfw\src\CMakeFiles\glfw.dir\glfw.pdb
  TARGET_FILE = include\glfw\src\glfw3.lib
  TARGET_PDB = include\glfw\src\glfw3.pdb


#############################################
# Utility command for update_mappings

build include\glfw\src\update_mappings: phony include\glfw\src\CMakeFiles\update_mappings


#############################################
# Utility command for edit_cache

build include\glfw\src\CMakeFiles\edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\Anhad\Documents-Unsynced\Push2-Resolume\out\build\x64-debug\include\glfw\src && "C:\Program Files\CMake\bin\cmake-gui.exe" -SC:\Users\Anhad\Documents-Unsynced\Push2-Resolume -BC:\Users\Anhad\Documents-Unsynced\Push2-Resolume\out\build\x64-debug"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build include\glfw\src\edit_cache: phony include\glfw\src\CMakeFiles\edit_cache.util


#############################################
# Utility command for rebuild_cache

build include\glfw\src\CMakeFiles\rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\Anhad\Documents-Unsynced\Push2-Resolume\out\build\x64-debug\include\glfw\src && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SC:\Users\Anhad\Documents-Unsynced\Push2-Resolume -BC:\Users\Anhad\Documents-Unsynced\Push2-Resolume\out\build\x64-debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build include\glfw\src\rebuild_cache: phony include\glfw\src\CMakeFiles\rebuild_cache.util


#############################################
# Utility command for list_install_components

build include\glfw\src\list_install_components: phony


#############################################
# Utility command for install

build include\glfw\src\CMakeFiles\install.util: CUSTOM_COMMAND include\glfw\src\all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\Anhad\Documents-Unsynced\Push2-Resolume\out\build\x64-debug\include\glfw\src && "C:\Program Files\CMake\bin\cmake.exe" -P cmake_install.cmake"
  DESC = Install the project...
  pool = console
  restat = 1

build include\glfw\src\install: phony include\glfw\src\CMakeFiles\install.util


#############################################
# Utility command for install/local

build include\glfw\src\CMakeFiles\install\local.util: CUSTOM_COMMAND include\glfw\src\all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\Anhad\Documents-Unsynced\Push2-Resolume\out\build\x64-debug\include\glfw\src && "C:\Program Files\CMake\bin\cmake.exe" -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake"
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build include\glfw\src\install\local: phony include\glfw\src\CMakeFiles\install\local.util


#############################################
# Custom command for include\glfw\src\CMakeFiles\update_mappings

build include\glfw\src\CMakeFiles\update_mappings | ${cmake_ninja_workdir}include\glfw\src\CMakeFiles\update_mappings: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\Anhad\Documents-Unsynced\Push2-Resolume\include\glfw\src && "C:\Program Files\CMake\bin\cmake.exe" -P C:/Users/Anhad/Documents-Unsynced/Push2-Resolume/include/glfw/CMake/GenerateMappings.cmake mappings.h.in mappings.h"
  DESC = Updating gamepad mappings from upstream repository

